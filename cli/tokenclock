#!/usr/bin/env bash
#
# tokenclock — TokenClock lightweight command-line
#
# Manages launching the floating clock: auto-selects the liquid-glass (26+) or normal (12+) build
# based on the macOS version, plus stop / restart / doctor / update.
#
# Designed to be POSIX/bash-3.2 compatible (the system /bin/bash is enough), no compilation needed.
# Install: sudo install -m755 cli/tokenclock /usr/local/bin/tokenclock
#
set -u

CLI_VERSION="1.3.2"
# Process name (comm) of the running clock. **The executable of every variant must be named TokenClock**
# (placed in a glass/ or normal/ subdir to distinguish variants), so that no matter which variant is
# launched the process name is TokenClock — the pgrep/pkill -x below hits it precisely and never
# accidentally matches the shell or the script itself.
APP_PROCESS="TokenClock"

# Constants shared across scripts (kept in sync with cli/install.sh)
MIN_MACOS=12              # minimum supported macOS major version (Monterey)
LIQUID_GLASS_MIN_MACOS=26 # minimum major version for the liquid-glass variant

# Update source: cmd_update pulls the latest install.sh from here (GitHub raw, CDN-cached ~5min).
# Override with the TOKENCLOCK_INSTALL_URL environment variable.
INSTALL_URL="${TOKENCLOCK_INSTALL_URL:-https://raw.githubusercontent.com/Neo-Isshin/TokenClock/main/cli/install.sh}"

# ─────────────────────────── helpers ───────────────────────────

die() { printf '%btokenclock: %s%b\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# Color output: only colorize on a TTY (auto-stripped when piped/redirected).
if [ -t 1 ]; then
  C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'; C_RESET=$'\033[0m'
else
  C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''; C_RESET=''
fi

# macOS major version (12 / 26 …)
os_major() { sw_vers -productVersion 2>/dev/null | cut -d. -f1; }

# Validate variant vs. macOS version compatibility; die on failure.
validate_variant_compat() {
  local variant="$1"
  case "$variant" in
    glass)
      local m; m="$(os_major)"
      if [ "${m:-0}" -lt "$LIQUID_GLASS_MIN_MACOS" ]; then
        die "The glass variant requires macOS $LIQUID_GLASS_MIN_MACOS+ (Liquid Glass material); current macOS is ${m:-unknown}. Use --normal to launch the classic build."
      fi
      ;;
    normal)
      # macOS 12+ all supported
      ;;
  esac
}

# PIDs of any running TokenClock (may be multiple lines).
# Double-matched, each as a fallback for the other:
#   ① executable path lives under ~/.tokenclock/ — covers the current glass/normal subdir layout and
#      the legacy tokenclock-glass/normal naming (where comm is not TokenClock);
#   ② process name is TokenClock — covers dev .build builds and /Applications .app bundles.
# The CLI itself lives in ~/.local/bin, so neither rule ever hits it or the shell.
running_pids() {
  { pgrep -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null; pgrep -x "$APP_PROCESS" 2>/dev/null; } | sort -u
}

# Print the first path that actually exists, or fail non-zero (no output).
first_existing() {
  local p
  for p in "$@"; do
    [ -e "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}

# If the script lives under <repo>/cli, return the repo root (for dev .build/debug builds); otherwise empty.
repo_dev_build() {
  local d p
  d="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || return 0
  p="$d/../.build/debug/TokenClock"
  if [ -f "$p" ]; then (cd "$d/.." && pwd); return; fi
  return 0
}

find_glass() {
  local repo; repo="$(repo_dev_build)"
  first_existing \
    "${TOKENCLOCK_GLASS:-}" \
    "$HOME/.tokenclock/TokenClock Glass.app" \
    "$HOME/.tokenclock/glass/TokenClock" \
    "/Applications/TokenClock Glass.app" \
    ${repo:+"$repo/.build/debug/TokenClock"}
}

find_normal() {
  first_existing \
    "${TOKENCLOCK_NORMAL:-}" \
    "$HOME/.tokenclock/TokenClock.app" \
    "$HOME/.tokenclock/normal/TokenClock" \
    "/Applications/TokenClock.app"
}

# Launch a given path: .app via open (auto-dedupes/activates), bare binary via nohup in the background.
launch_path() {
  case "$1" in
    *.app) open "$1" ;;
    *) nohup "$1" >/dev/null 2>&1 & ;;
  esac
}

env_var_for() { case "$1" in glass) echo TOKENCLOCK_GLASS ;; normal) echo TOKENCLOCK_NORMAL ;; esac; }

# Unload a variant's LaunchAgent (does not delete the plist: stopped this session, not revived,
# comes back on next login/start). Uses the legacy `launchctl unload <plist>`, the same API as
# LaunchAgentHelper.disable(). The path must exactly match the Swift-side plistURL():
# ~/Library/LaunchAgents/com.tokenclock.app.<variant>.plist
launchagent_plist() { echo "$HOME/Library/LaunchAgents/com.tokenclock.app.$1.plist"; }
unload_launchagent() {
  local plist; plist="$(launchagent_plist "$1")"
  [ -f "$plist" ] && launchctl unload "$plist" 2>/dev/null || true
}

# ─────────────────────────── command implementations ───────────────────────────

cmd_start() {
  local variant="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --glass|--liquid-glass) variant=glass ;;
      --normal|--classic)     variant=normal ;;
      --force)                force=1 ;;
      -h|--help)              echo "Usage: tokenclock start [--glass|--normal] [--force]"; return 0 ;;
      *)                      die "Unknown argument: $1 (use --glass / --normal / --force)" ;;
    esac
    shift
  done

  # Already running? Refuse to launch a duplicate by default (fixes the "two instances at once" problem)
  local pids; pids="$(running_pids)"
  if [ -n "$pids" ] && [ "$force" -eq 0 ]; then
    echo "TokenClock is already running (pid $(echo $pids | tr '\n' ' '))."
    echo "${C_YELLOW}Use tokenclock restart to restart, or tokenclock start --force to launch another instance${C_RESET}"
    return 0
  fi

  # If not specified explicitly, auto-select by macOS version
  if [ -z "$variant" ]; then
    local m; m="$(os_major)"
    if   [ "$m" -ge "$LIQUID_GLASS_MIN_MACOS" ]; then variant=glass;  echo "Detected macOS $m → auto-selecting the liquid-glass build"
    elif [ "$m" -ge "$MIN_MACOS" ]; then variant=normal; echo "Detected macOS $m → auto-selecting the normal build"
    else die "macOS $MIN_MACOS or later is required (current major version ${m:-unknown})."
    fi
  fi

  # Validate variant vs. macOS version compatibility (glass needs macOS 26+; normal is universal)
  validate_variant_compat "$variant"

  local path
  case "$variant" in
    glass)  path="$(find_glass)" ;;
    normal) path="$(find_normal)" ;;
  esac

  if [ -z "$path" ]; then
    die "No $variant executable found. Set the \$$(env_var_for "$variant") environment variable, or install to ~/.tokenclock or /Applications."
  fi

  launch_path "$path"
  echo "Started the $variant build: $path"
}

cmd_stop() {
  local pids; pids="$(running_pids)"
  if [ -z "$pids" ]; then echo "TokenClock is not running."; return 0; fi
  # Unload the LaunchAgent first: otherwise launchd's KeepAlive.Crashed treats the SIGTERM from pkill
  # below as a "crash" and immediately revives the process (the menu Quit goes through
  # NSApplication.terminate for a clean exit and is unaffected; only the pkill/SIGTERM path has this
  # issue). Try unloading both variants' plists; ignore ones that don't exist.
  unload_launchagent glass
  unload_launchagent normal
  pkill    -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null
  pkill    -x "$APP_PROCESS" 2>/dev/null
  sleep 2
  if [ -n "$(running_pids)" ]; then
    pkill -9 -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null
    pkill -9 -x "$APP_PROCESS" 2>/dev/null
    sleep 0.3
  fi
  if [ -n "$(running_pids)" ]; then
    echo "Warning: some processes could not be stopped (pid $(running_pids | tr '\n' ' '))." >&2
    return 1
  fi
  echo "Stopped TokenClock."
}

cmd_restart() {
  cmd_stop
  cmd_start "$@"
}

# Uninstall: stop the service + remove both variant plists + remove the ~/.tokenclock runtime dir.
# Keep the `tokenclock` CLI command itself (handy for reinstalling); to remove the CLI too, see the
# manual path noted at the end.
cmd_uninstall() {
  echo "Uninstalling TokenClock…"
  # 1. Stop the service: unload (prevents KeepAlive revival) + pkill fallback
  unload_launchagent glass
  unload_launchagent normal
  pkill -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null
  pkill -x "$APP_PROCESS" 2>/dev/null
  sleep 1
  # 2. Remove both variants' plists
  local v
  for v in glass normal; do
    rm -f "$(launchagent_plist "$v")"
  done
  # 3. Remove the runtime directory (binary + resource bundle)
  if [ -d "$HOME/.tokenclock" ]; then
    rm -rf "$HOME/.tokenclock"
    echo "  ✓ Removed ~/.tokenclock"
  fi
  echo "${C_GREEN}✓ Uninstalled TokenClock (runtime + LaunchAgent plist).${C_RESET}"
  echo "  The 'tokenclock' CLI command is kept. To reinstall:"
  echo "    curl -fsSL https://raw.githubusercontent.com/Neo-Isshin/TokenClock/main/cli/install.sh | bash"
  echo "  To also remove the CLI itself: sudo rm -f /usr/local/bin/tokenclock"
}

cmd_doctor() {
  local m path pids
  m="$(os_major)"
  echo "TokenClock CLI v$CLI_VERSION"
  echo "macOS $(sw_vers -productVersion 2>/dev/null) (major version ${m:-unknown})"
  if   [ "$m" -ge "$LIQUID_GLASS_MIN_MACOS" ]; then echo "→ Auto-select: liquid-glass build"
  elif [ "$m" -ge "$MIN_MACOS" ]; then echo "→ Auto-select: normal build"
  else echo "→ ⚠ System version too low (needs macOS $MIN_MACOS+)"
  fi
  echo

  path="$(find_glass)";  [ -n "$path" ] && echo "liquid-glass:  ✓ $path" || echo "liquid-glass:  ✗ not found"
  path="$(find_normal)"; [ -n "$path" ] && echo "normal:        ✓ $path" || echo "normal:        ✗ not found"
  echo

  pids="$(running_pids)"
  if [ -n "$pids" ]; then echo "Running: pid $(echo $pids | tr '\n' ' ')"; else echo "Running: none"; fi
  echo
  echo "Env vars: TOKENCLOCK_GLASS=${TOKENCLOCK_GLASS:-(unset)}  TOKENCLOCK_NORMAL=${TOKENCLOCK_NORMAL:-(unset)}"
}

cmd_update() {
  local variant="" check_only=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --glass|--liquid-glass) variant=glass ;;
      --normal|--classic)     variant=normal ;;
      --check)                check_only=1 ;;
      --force)                force=1 ;;
      -h|--help)              echo "Usage: tokenclock update [--glass|--normal] [--check] [--force]"; return 0 ;;
      *)                      die "Unknown argument: $1 (use --glass / --normal / --check / --force)" ;;
    esac
    shift
  done

  say "Current CLI version: v$CLI_VERSION"
  say "Update source: $INSTALL_URL"

  # Download install.sh to a temp file (umask 077 so only the current user can read it).
  # Goes straight to the public URL via the CDN to spare the origin's bandwidth; CDN cache is
  # managed on the ops side.
  local tmp_script
  tmp_script="$(umask 077; mktemp -t tokenclock-install.XXXXXX)" \
    || die "Failed to create a temp file"
  # The CDN edge occasionally drops the TCP/TLS handshake (SSL_ERROR_SYSCALL, ~30% failure rate);
  # retrying 3 times with short backoff smooths out the transient blips.
  local attempt=1 max_attempts=3
  while [ "$attempt" -le "$max_attempts" ]; do
    if curl -fsSL --http2 --max-time 60 "$INSTALL_URL" -o "$tmp_script"; then
      break
    fi
    if [ "$attempt" -eq "$max_attempts" ]; then
      rm -f "$tmp_script"
      die "Failed to download the installer (all $max_attempts retries failed; check your network or TOKENCLOCK_INSTALL_URL)"
    fi
    say "  ${C_YELLOW}⚠ Download failed, retrying $((attempt+1))/$max_attempts...${C_RESET}"
    sleep $((attempt * 2))
    attempt=$((attempt+1))
  done
  chmod +x "$tmp_script" || { rm -f "$tmp_script"; die "Failed to chmod the temp file"; }
  say "✓ Downloaded the latest installer"

  if [ "$check_only" -eq 1 ]; then
    say "Checked (no upgrade performed)"
    rm -f "$tmp_script"
    return 0
  fi

  # Don't stop up front: install.sh's cp can overwrite the running binary (macOS unlink semantics
  # allow it). Only restart when something was actually deployed (or --force) — restart does
  # stop+start internally — so we avoid interrupting a running clock when nothing changed.
  local status_file force_arg=""
  status_file="$(umask 077; mktemp -t tokenclock-status.XXXXXX)" || die "Failed to create a status file"
  [ "$force" -eq 1 ] && force_arg="--force"

  # Run the installer with --no-start: fetch + build + cp as needed; it reports DEPLOYED via the
  # status file. --no-start skips the API prompt (preserves existing UserDefaults) and the first-launch
  # scan; detect_and_set_language is also guarded off on this path, respecting the user's chosen language.
  if ! TOKENCLOCK_STATUS_FILE="$status_file" bash "$tmp_script" --no-start $force_arg; then
    rm -f "$tmp_script" "$status_file"
    die "Upgrade failed (state restored, the old binary was not replaced)"
  fi
  rm -f "$tmp_script"

  # Read the deploy status reported by install.sh:
  #   DEPLOYED=1     clock binary changed → restart the running clock
  #   CLI_UPDATED=1  only the wrapper changed → don't restart the clock, just note "CLI updated"
  local deployed=0 cli_updated=0
  if [ -f "$status_file" ]; then
    deployed=$(grep -oE 'DEPLOYED=[01]' "$status_file" | tail -1 | cut -d= -f2)
    cli_updated=$(grep -oE 'CLI_UPDATED=[01]' "$status_file" | tail -1 | cut -d= -f2)
  fi
  rm -f "$status_file"

  if [ "$force" -eq 1 ] || [ "$deployed" = "1" ]; then
    say "${C_GREEN}✓ Update deployed, restarting…${C_RESET}"
    # Restart: when no variant is given, use the current default (auto-selected by macOS version);
    # when the user passes --glass/--normal, forward it.
    if [ -n "$variant" ]; then
      cmd_restart "--$variant"
    else
      cmd_restart
    fi
  elif [ "$cli_updated" = "1" ]; then
    # Only the CLI wrapper changed: independent of the running clock binary, no restart needed.
    say "${C_GREEN}✓ CLI updated to v${CLI_VERSION}; the running clock does not need a restart${C_RESET}"
  else
    say "${C_CYAN}✓ Already up to date, no restart needed (the running clock is unaffected)${C_RESET}"
  fi
}

usage() {
  cat <<EOF
tokenclock v$CLI_VERSION — TokenClock lightweight command-line

Usage:
  tokenclock start [--glass|--normal] [--force]   start (auto-selects by macOS version; the flag forces it)
  tokenclock stop                                 stop all instances (unloads the LaunchAgent so KeepAlive won't revive it)
  tokenclock restart [--glass|--normal]           restart
  tokenclock uninstall                            uninstall (stops the service + removes both variant plists + removes ~/.tokenclock; keeps the CLI)
  tokenclock doctor                               diagnose the environment and installed versions
  tokenclock update [--glass|--normal] [--check] [--force]  update (rebuilds + restarts only on change; --force forces it)
  tokenclock help                                 show this help

Lookup order for each variant:
  \$TOKENCLOCK_GLASS / \$TOKENCLOCK_NORMAL  →  ~/.tokenclock/  →  /Applications/  →  repo .build/debug/

Note: --glass requires macOS 26+; --normal works on macOS 12+.

Install onto PATH: sudo install -m755 cli/tokenclock /usr/local/bin/tokenclock
EOF
}

# ─────────────────────────── dispatch ───────────────────────────

case "${1:-help}" in
  start)              [ $# -gt 0 ] && shift; cmd_start "$@" ;;
  stop)               cmd_stop ;;
  restart)            [ $# -gt 0 ] && shift; cmd_restart "$@" ;;
  uninstall)          cmd_uninstall ;;
  doctor|dr)          cmd_doctor ;;
  update)             [ $# -gt 0 ] && shift; cmd_update "$@" ;;
  help|-h|--help)     usage ;;
  "")                 usage ;;
  *)                  die "Unknown command: $1 (use 'tokenclock help' for usage)" ;;
esac
