#!/usr/bin/env bash
#
# tokenclock — TokenClock 轻量命令行
#
# 管理浮动时钟的启动：按 macOS 版本自动选 liquid-glass（26+）或 normal（12+）构建，
# 以及 stop / restart / doctor / update。
#
# 设计为 POSIX/bash-3.2 兼容（macOS 自带 /bin/bash 即可），无需编译。
# 安装：sudo install -m755 cli/tokenclock /usr/local/bin/tokenclock
#
set -u

CLI_VERSION="1.2.1"
# 运行中时钟的进程名（comm）。**所有变体的可执行文件都必须叫 TokenClock**
#（放在 glass/ normal/ 子目录里区分变体），这样无论启动哪个变体，进程名都是 TokenClock，
# 下面的 pgrep/pkill -x 才能精确命中、且不会误伤 shell/脚本本身。
APP_PROCESS="TokenClock"

# 跨脚本共享常量（与 cli/install.sh 保持同步）
MIN_MACOS=12              # 最低支持 macOS 主版本（Monterey）
LIQUID_GLASS_MIN_MACOS=26 # liquid-glass 变体最低主版本

# 更新源：cmd_update 从这里拉取最新 install.sh。
# 走 gitea API（/api/v1/repos/<owner>/<repo>/raw/<path>?ref=<branch>）而非
# /<owner>/<repo>/raw/<branch>/<path>，因为后者被 CDN（腾讯 EdgeOne）6h 缓存，
# push 完要等缓存过期才能拿到新版；前者直连源站（也走 CDN，但 query string 不在缓存键里）。
# 可通过 TOKENCLOCK_INSTALL_URL 环境变量覆盖（LAN 用户指向 localhost:3000）。
INSTALL_URL="${TOKENCLOCK_INSTALL_URL:-https://gitea.nxc8335.cloud/api/v1/repos/nxc8335/TokenClock/raw/cli/install.sh?ref=main}"

# ─────────────────────────── 辅助函数 ───────────────────────────

die() { printf '%btokenclock: %s%b\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# 彩色输出：仅 TTY 上色（脚本被管道/重定向时自动去色）。
if [ -t 1 ]; then
  C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'; C_RESET=$'\033[0m'
else
  C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''; C_RESET=''
fi

# macOS 主版本号（12 / 26 …）
os_major() { sw_vers -productVersion 2>/dev/null | cut -d. -f1; }

# 校验变体与系统版本兼容性,失败时 die。
validate_variant_compat() {
  local variant="$1"
  case "$variant" in
    glass)
      local m; m="$(os_major)"
      if [ "${m:-0}" -lt "$LIQUID_GLASS_MIN_MACOS" ]; then
        die "glass 变体需要 macOS $LIQUID_GLASS_MIN_MACOS+（液态玻璃材质），当前 macOS ${m:-未知}。请用 --normal 启动 classic 版。"
      fi
      ;;
    normal)
      # macOS 12+ 都支持
      ;;
  esac
}

# 运行中的 TokenClock pid（可能多行）。
# 双重命中，互为兜底：
#   ① 可执行路径位于 ~/.tokenclock/ 下 —— 覆盖当前 glass/normal 子目录布局，也覆盖
#      历史遗留的 tokenclock-glass/normal 命名（那种情况下 comm 不是 TokenClock）；
#   ② 进程名为 TokenClock —— 覆盖开发态 .build 构建与 /Applications 的 .app。
# CLI 自身在 ~/.local/bin，两条规则都不会误伤它或 shell。
running_pids() {
  { pgrep -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null; pgrep -x "$APP_PROCESS" 2>/dev/null; } | sort -u
}

# 打印第一个真实存在的路径，否则返回非零（不输出）
first_existing() {
  local p
  for p in "$@"; do
    [ -e "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}

# 若脚本位于 <repo>/cli 下，返回仓库根（用于开发态的 .build/debug 构建）；否则空
repo_dev_build() {
  local d p
  d="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || return 0
  p="$d/../.build/debug/TokenClock"
  if [ -f "$p" ]; then (cd "$d/.." && pwd); return; fi
  return 0
}

find_glass() {
  local repo; repo="$(repo_dev_build)"
  first_existing \
    "${TOKENCLOCK_GLASS:-}" \
    "$HOME/.tokenclock/TokenClock Glass.app" \
    "$HOME/.tokenclock/glass/TokenClock" \
    "/Applications/TokenClock Glass.app" \
    ${repo:+"$repo/.build/debug/TokenClock"}
}

find_normal() {
  first_existing \
    "${TOKENCLOCK_NORMAL:-}" \
    "$HOME/.tokenclock/TokenClock.app" \
    "$HOME/.tokenclock/normal/TokenClock" \
    "/Applications/TokenClock.app"
}

# 启动给定路径：.app 用 open（自动去重/激活），裸二进制用 nohup 后台拉起
launch_path() {
  case "$1" in
    *.app) open "$1" ;;
    *) nohup "$1" >/dev/null 2>&1 & ;;
  esac
}

env_var_for() { case "$1" in glass) echo TOKENCLOCK_GLASS ;; normal) echo TOKENCLOCK_NORMAL ;; esac; }

# ─────────────────────────── 命令实现 ───────────────────────────

cmd_start() {
  local variant="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --glass|--liquid-glass) variant=glass ;;
      --normal|--classic)     variant=normal ;;
      --force)                force=1 ;;
      -h|--help)              echo "用法: tokenclock start [--glass|--normal] [--force]"; return 0 ;;
      *)                      die "未知参数: $1（可用 --glass / --normal / --force）" ;;
    esac
    shift
  done

  # 已在运行？默认拒绝重复拉起（解决「同时两个实例」问题）
  local pids; pids="$(running_pids)"
  if [ -n "$pids" ] && [ "$force" -eq 0 ]; then
    echo "TokenClock 已在运行（pid $(echo $pids | tr '\n' ' ')）。"
    echo "${C_YELLOW}重启请用: tokenclock restart    另开一份请用: tokenclock start --force${C_RESET}"
    return 0
  fi

  # 未显式指定则按系统版本自动选
  if [ -z "$variant" ]; then
    local m; m="$(os_major)"
    if   [ "$m" -ge "$LIQUID_GLASS_MIN_MACOS" ]; then variant=glass;  echo "检测到 macOS $m → 自动选择 liquid-glass 版"
    elif [ "$m" -ge "$MIN_MACOS" ]; then variant=normal; echo "检测到 macOS $m → 自动选择 normal 版"
    else die "需要 macOS $MIN_MACOS 或更高版本（当前主版本 ${m:-未知}）。"
    fi
  fi

  # 校验变体与系统版本兼容性（glass 必须 macOS 26+；normal 通用）
  validate_variant_compat "$variant"

  local path
  case "$variant" in
    glass)  path="$(find_glass)" ;;
    normal) path="$(find_normal)" ;;
  esac

  if [ -z "$path" ]; then
    die "未找到 $variant 版可执行文件。请设置 \$$(env_var_for "$variant") 环境变量，或安装到 ~/.tokenclock 或 /Applications。"
  fi

  launch_path "$path"
  echo "已启动 $variant 版: $path"
}

cmd_stop() {
  local pids; pids="$(running_pids)"
  if [ -z "$pids" ]; then echo "TokenClock 未在运行。"; return 0; fi
  pkill    -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null
  pkill    -x "$APP_PROCESS" 2>/dev/null
  sleep 2
  if [ -n "$(running_pids)" ]; then
    pkill -9 -f "${HOME}/.tokenclock/[^/]*/TokenClock( |$)" 2>/dev/null
    pkill -9 -x "$APP_PROCESS" 2>/dev/null
    sleep 0.3
  fi
  if [ -n "$(running_pids)" ]; then
    echo "警告：部分进程未能停止（pid $(running_pids | tr '\n' ' ')）。" >&2
    return 1
  fi
  echo "已停止 TokenClock。"
}

cmd_restart() {
  cmd_stop
  cmd_start "$@"
}

cmd_doctor() {
  local m path pids
  m="$(os_major)"
  echo "TokenClock CLI v$CLI_VERSION"
  echo "macOS $(sw_vers -productVersion 2>/dev/null)（主版本 ${m:-未知}）"
  if   [ "$m" -ge "$LIQUID_GLASS_MIN_MACOS" ]; then echo "→ 自动选择: liquid-glass 版"
  elif [ "$m" -ge "$MIN_MACOS" ]; then echo "→ 自动选择: normal 版"
  else echo "→ ⚠ 系统版本过低（需 macOS $MIN_MACOS+）"
  fi
  echo

  path="$(find_glass)";  [ -n "$path" ] && echo "liquid-glass:  ✓ $path" || echo "liquid-glass:  ✗ 未找到"
  path="$(find_normal)"; [ -n "$path" ] && echo "normal:        ✓ $path" || echo "normal:        ✗ 未找到"
  echo

  pids="$(running_pids)"
  if [ -n "$pids" ]; then echo "运行中: pid $(echo $pids | tr '\n' ' ')"; else echo "运行中: 无"; fi
  echo
  echo "环境变量: TOKENCLOCK_GLASS=${TOKENCLOCK_GLASS:-（未设置）}  TOKENCLOCK_NORMAL=${TOKENCLOCK_NORMAL:-（未设置）}"
}

cmd_update() {
  local variant="" check_only=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --glass|--liquid-glass) variant=glass ;;
      --normal|--classic)     variant=normal ;;
      --check)                check_only=1 ;;
      --force)                force=1 ;;
      -h|--help)              echo "用法: tokenclock update [--glass|--normal] [--check] [--force]"; return 0 ;;
      *)                      die "未知参数: $1（可用 --glass / --normal / --check / --force）" ;;
    esac
    shift
  done

  say "当前 CLI 版本: v$CLI_VERSION"
  say "更新源: $INSTALL_URL"

  # 下载 install.sh 到临时文件（umask 077 保证只有当前用户能读）。
  # 走公开 URL 直通 CDN,保护源站带宽;CDN 缓存由运营侧维护。
  local tmp_script
  tmp_script="$(umask 077; mktemp -t tokenclock-install.XXXXXX)" \
    || die "创建临时文件失败"
  # CDN 边缘偶发 TCP/TLS 握手断（SSL_ERROR_SYSCALL，约 30% 失败率），
  # 重试 3 次 + 短退避可消除瞬时抖动。
  local attempt=1 max_attempts=3
  while [ "$attempt" -le "$max_attempts" ]; do
    if curl -fsSL --http2 --max-time 60 "$INSTALL_URL" -o "$tmp_script"; then
      break
    fi
    if [ "$attempt" -eq "$max_attempts" ]; then
      rm -f "$tmp_script"
      die "下载安装器失败（$max_attempts 次重试均失败，检查网络或 TOKENCLOCK_INSTALL_URL）"
    fi
    say "  ${C_YELLOW}⚠ 下载失败,重试 $((attempt+1))/$max_attempts...${C_RESET}"
    sleep $((attempt * 2))
    attempt=$((attempt+1))
  done
  chmod +x "$tmp_script" || { rm -f "$tmp_script"; die "chmod 临时文件失败"; }
  say "✓ 已下载最新安装器"

  if [ "$check_only" -eq 1 ]; then
    say "已检查（未执行升级）"
    rm -f "$tmp_script"
    return 0
  fi

  # 不预先 stop：install.sh 的 cp 可覆盖运行中二进制（macOS unlink 语义允许），
  # 仅在确实部署了变更（或 --force）时才 restart（restart 内部 stop+start），
  # 避免无变化时打断正在运行的时钟。
  local status_file force_arg=""
  status_file="$(umask 077; mktemp -t tokenclock-status.XXXXXX)" || die "创建状态文件失败"
  [ "$force" -eq 1 ] && force_arg="--force"

  # 执行安装器 --no-start：fetch + build + 按需 cp；通过状态文件回报 DEPLOYED。
  # --no-start 跳过 API prompt（保留已有 UserDefaults）和首启扫描；
  # detect_and_set_language 也在该路径下被守卫跳过，尊重用户已选语言。
  if ! TOKENCLOCK_STATUS_FILE="$status_file" bash "$tmp_script" --no-start $force_arg; then
    rm -f "$tmp_script" "$status_file"
    die "升级失败（已恢复原状态，旧二进制未被替换）"
  fi
  rm -f "$tmp_script"

  # 读 install.sh 回报的部署状态：
  #   DEPLOYED=1     时钟二进制变了 → 重启运行中的时钟
  #   CLI_UPDATED=1  仅 wrapper 变了 → 不重启时钟，只提示「CLI 已更新」
  local deployed=0 cli_updated=0
  if [ -f "$status_file" ]; then
    deployed=$(grep -oE 'DEPLOYED=[01]' "$status_file" | tail -1 | cut -d= -f2)
    cli_updated=$(grep -oE 'CLI_UPDATED=[01]' "$status_file" | tail -1 | cut -d= -f2)
  fi
  rm -f "$status_file"

  if [ "$force" -eq 1 ] || [ "$deployed" = "1" ]; then
    say "${C_GREEN}✓ 已部署更新，重启中…${C_RESET}"
    # 重启：不指定 variant 时按当前默认（系统版本）自动选；用户 --glass/--normal 限定时传递。
    if [ -n "$variant" ]; then
      cmd_restart "--$variant"
    else
      cmd_restart
    fi
  elif [ "$cli_updated" = "1" ]; then
    # 仅 CLI wrapper 变了：与运行中的时钟二进制互相独立，无需重启。
    say "${C_GREEN}✓ CLI 已更新到 v${CLI_VERSION}，运行中的时钟无需重启${C_RESET}"
  else
    say "${C_CYAN}✓ 已是最新版本，无需重启（运行中的时钟未受影响）${C_RESET}"
  fi
}

usage() {
  cat <<EOF
tokenclock v$CLI_VERSION — TokenClock 轻量命令行

用法:
  tokenclock start [--glass|--normal] [--force]   启动（按系统版本自动选；flag 强制）
  tokenclock stop                                 停止所有实例
  tokenclock restart [--glass|--normal]           重启
  tokenclock doctor                               诊断环境与已安装版本
  tokenclock update [--glass|--normal] [--check] [--force]  更新（仅在有变更时重建+重启；--force 强制）
  tokenclock help                                 显示此帮助

每个变体的定位顺序:
  \$TOKENCLOCK_GLASS / \$TOKENCLOCK_NORMAL  →  ~/.tokenclock/  →  /Applications/  →  仓库 .build/debug/

注意: --glass 需要 macOS 26+; --normal 适用 macOS 12+。

安装到 PATH: sudo install -m755 cli/tokenclock /usr/local/bin/tokenclock
EOF
}

# ─────────────────────────── 分发 ───────────────────────────

case "${1:-help}" in
  start)              [ $# -gt 0 ] && shift; cmd_start "$@" ;;
  stop)               cmd_stop ;;
  restart)            [ $# -gt 0 ] && shift; cmd_restart "$@" ;;
  doctor|dr)          cmd_doctor ;;
  update)             [ $# -gt 0 ] && shift; cmd_update "$@" ;;
  help|-h|--help)     usage ;;
  "")                 usage ;;
  *)                  die "未知命令: $1（用 'tokenclock help' 查看用法）" ;;
esac
